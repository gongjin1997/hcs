# 复制为 .env 后按环境修改；所有变量均以 INSPECTOR_ 为前缀
INSPECTOR_ENV=dev
INSPECTOR_DATABASE_URL=sqlite:///./dev.db
# INSPECTOR_DATABASE_URL=postgresql+psycopg://inspector:inspector@localhost:5432/inspector
# INSPECTOR_REDIS_URL=redis://localhost:6379/0
# 生产必须改为 ≥32 字节随机串：openssl rand -hex 32
INSPECTOR_JWT_SECRET=change-me-in-prod-use-32+-random-bytes
INSPECTOR_MAIL_LINK_SECRET=change-me-too
INSPECTOR_DEMO_SEED=true
INSPECTOR_BASE_URL=http://localhost:5173
# 本机日志：Docker/LAN 启动器已负责轮转，通常仅保留标准错误输出。
# 直接运行后端时可设置 LOG_DIR；同一服务多进程请使用容器/监督器统一轮转。
INSPECTOR_LOG_LEVEL=INFO
# INSPECTOR_LOG_DIR=./logs
# INSPECTOR_LOG_MAX_BYTES=10485760
# INSPECTOR_LOG_BACKUP_COUNT=5
# INSPECTOR_LOG_SLOW_REQUEST_MS=2000
INSPECTOR_SMTP_HOST=localhost
INSPECTOR_SMTP_PORT=1025
# 本地联调 Mock HCS（python -m uvicorn mock_hcs.app:app --port 9000）
INSPECTOR_HCS_SCHEME=http
INSPECTOR_HCS_IAM_URL=http://127.0.0.1:9000
# 巡检用到的服务挂在 Mock 根路径；台账同步用到的服务挂在 /ecs、/evs ... 前缀下（真实环境按局点 Endpoint 填写，可用 {region}/{domain} 模板）
INSPECTOR_HCS_ENDPOINTS={"dataarts":"127.0.0.1:9000","mrs":"127.0.0.1:9000","gaussdb":"127.0.0.1:9000","dcs":"127.0.0.1:9000","ecs":"127.0.0.1:9000/ecs","evs":"127.0.0.1:9000/evs","vpc":"127.0.0.1:9000/vpc","elb":"127.0.0.1:9000/elb","cce":"127.0.0.1:9000/cce","dws":"127.0.0.1:9000/dws"}
# 当前局点无 CES；AUTO 从不探测 CES。仅旧部署兼容时显式启用并选择 CES。
INSPECTOR_HCS_CES_ENABLED=false
# GaussDB 接口族须与现场组件一致；可选 v3.3 / v3.2 / v3.1 / opengauss_v3，不自动试探。
INSPECTOR_HCS_GAUSSDB_API_VARIANT=v3.3
# AOM 已全局停用：所有资源（含 ECS）均不请求；不要新增 AOM 地址或映射。
# 旧 AOM 配置仅保留历史；ECS 可选租户已有 Prometheus，DCS/GaussDB 使用原生接口。
# IAM Token 按响应 expires_at 缓存；Redis 跨进程共享需要 MASTER_KEY，加密保存 Token。
INSPECTOR_HCS_PROJECT_ID=0a1b2c3d4e5f
INSPECTOR_HCS_USERNAME=inspector_ro
INSPECTOR_HCS_PASSWORD=mock-password
INSPECTOR_HCS_DOMAIN=vdc_ops
INSPECTOR_HCS_WORKSPACES=["ws-bigdata"]
# 云请求保护：每服务跨客户端/任务共享平滑限速；配置 Redis 时跨进程共享。
# QPS 在「系统设置 → HCS 采集性能」修改；以下是进程级保护上限。
# INSPECTOR_HCS_MAX_ATTEMPTS=3
# INSPECTOR_HCS_SERVICE_CONCURRENCY=2
# INSPECTOR_HCS_TOTAL_QPS=10
# INSPECTOR_HCS_TOTAL_CONCURRENCY=4
# INSPECTOR_HCS_ACQUIRE_TIMEOUT_SECONDS=30
# v0.3 多租户：HCS 租户在「系统管理 → 租户接入」页面维护（账号密码 / AK/SK，凭据用 MASTER_KEY 加密入库）；上面的单账号配置仅在库里没有租户时兜底
# INSPECTOR_MASTER_KEY=<openssl rand -base64 32 生成并备份>
# 本地联调：全部租户（含 AK/SK 租户）的 IAM / 服务 Endpoint 指向 Mock HCS（prod 忽略）
# INSPECTOR_HCS_MOCK_URL=http://127.0.0.1:9000
# v0.4：数据保留期、报表发送时间 / 收件人、平台自身告警阈值在「系统管理 → 系统设置 / 巡检任务」页面维护，下面的环境变量只作首次默认值
# 容器事件：保留天数、背压结束判定分钟数（背压关键字正则见 INSPECTOR_POD_BACKPRESSURE_PATTERN）
# INSPECTOR_POD_EVENT_RETENTION_DAYS=30
# INSPECTOR_POD_BACKPRESSURE_RECOVER_MIN=5

# 报表：定时生成（crontab，时区 Asia/Shanghai）并发送到收件人；收件人为空时只生成不发送
# INSPECTOR_REPORT_CRON={"DAILY":"30 8 * * *","WEEKLY":"0 9 * * mon","MONTHLY":"0 9 1 * *"}
INSPECTOR_REPORT_MAIL_TO=["ops-team@example.com"]
# 登录：运维组内部使用，账号密码登录；勾选“7 天内免登录”时 token 有效期为 jwt_remember_days
# INSPECTOR_JWT_EXPIRE_MINUTES=720
# INSPECTOR_JWT_REMEMBER_DAYS=7
