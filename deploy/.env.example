# ======================================================================
# HCS-Inspector 部署配置（docker compose 自动读取同目录 .env）
# 首次部署：scripts/gen-env.sh 由本模板生成 .env 并填入随机密钥；再按局点修改标注「必改」的项
# .env 含密钥：权限 600，不要提交到代码仓库；INSPECTOR_MASTER_KEY 必须离线备份（丢失后租户凭据无法解密）
# ======================================================================

# ---------- compose ----------
COMPOSE_PROJECT_NAME=hcs-inspector
# 启用的 compose 文件（冒号分隔）：
#   生产 HTTP：docker-compose.yml
#   生产 HTTPS：docker-compose.yml:docker-compose.https.yml（证书放 nginx/certs/）
#   演示 / Mock 联调：docker-compose.yml:docker-compose.demo.yml（不要用于生产）
COMPOSE_FILE=docker-compose.yml
HCS_INSPECTOR_VERSION=0.4.0
# 镜像名前缀；使用私有镜像仓库时例如 harbor.example.com/ops/hcs-inspector
IMAGE_PREFIX=hcs-inspector
# 数据目录（PostgreSQL / Redis 数据）与备份目录、备份保留份数
DATA_DIR=./data
BACKUP_DIR=./backups
BACKUP_KEEP=14
# 控制台监听地址与端口（HTTPS 端口仅在启用 docker-compose.https.yml 时生效）
WEB_BIND=0.0.0.0
WEB_PORT=80
WEB_HTTPS_PORT=443
TZ=Asia/Shanghai
API_WORKERS=2

# ---------- 数据库（gen-env.sh 生成随机口令）----------
POSTGRES_DB=inspector
POSTGRES_USER=inspector
POSTGRES_PASSWORD=__GEN_DB_PASSWORD__

# ---------- 安全（gen-env.sh 自动生成，勿用示例值）----------
INSPECTOR_ENV=prod
INSPECTOR_JWT_SECRET=__GEN_HEX_32__
INSPECTOR_MAIL_LINK_SECRET=__GEN_HEX_24__
# 租户凭据（IAM 密码 / SK）AES-256-GCM 加密主密钥：务必离线备份
INSPECTOR_MASTER_KEY=__GEN_MASTER_KEY__
# 首次部署创建 admin 的初始口令（make install 结束时会提示）；首次登录后立即修改，并把本行清空
INSPECTOR_INIT_ADMIN_PASSWORD=__GEN_ADMIN_PASSWORD__
# /metrics 访问令牌：内网 Prometheus 经控制台地址抓取 /metrics 时带 Authorization: Bearer <令牌>（来源白名单见 nginx/snippets/metrics-allow.conf）
INSPECTOR_METRICS_TOKEN=__GEN_HEX_16__
INSPECTOR_LOGIN_MAX_FAILURES=5
INSPECTOR_LOGIN_LOCK_MINUTES=10

# ---------- 访问地址 / 邮件（必改）----------
# 邮件中“查看详情 / 认领”链接的前缀：运维同事能打开的控制台地址
INSPECTOR_BASE_URL=http://inspector.example.com
# 邮件主题前缀，例如【PROD】
INSPECTOR_ENV_TAG=PROD
INSPECTOR_SMTP_HOST=smtp.example.com
INSPECTOR_SMTP_PORT=25
INSPECTOR_SMTP_STARTTLS=false
INSPECTOR_SMTP_USER=
INSPECTOR_SMTP_PASSWORD=
INSPECTOR_SMTP_SENDER=hcs-inspector@example.com
INSPECTOR_SMTP_REPLY_TO=ops-oncall@example.com
# 邮件服务器 STARTTLS 使用内部 CA 时：证书放 deploy/certs/，例如 /app/certs/smtp-ca.pem
INSPECTOR_SMTP_CA_FILE=
# 合并报表的初始收件人（JSON 数组）；上线后在“系统管理 → 巡检任务 → 修改发送时间 / 收件人”维护
INSPECTOR_REPORT_MAIL_TO=[]

# ---------- HCS 接入 ----------
# 租户（IAM 账号密码 / AK/SK、纳管项目、DataArts 工作空间）在控制台「系统管理 → 租户接入」维护，这里只放局点级参数
INSPECTOR_HCS_SCHEME=https
# 校验 HCS 接口证书；局点 API 网关是内部 CA 签发时把 CA 放 deploy/certs/hcs-ca.pem 并配置下一行
INSPECTOR_HCS_VERIFY=true
INSPECTOR_HCS_CA_FILE=
# 邮件里“HCS 控制台”链接用：https://console.<region>.<domain>/
INSPECTOR_HCS_REGION=region-01
INSPECTOR_HCS_EXTERNAL_DOMAIN=example.com
# 服务 Endpoint 模板（JSON，{region} / {domain} 取租户项目配置）；局点个别服务域名不同时整体覆盖，租户接入里也可按租户覆盖
# INSPECTOR_HCS_ENDPOINTS={"ecs":"ecs.{region}.{domain}","evs":"evs.{region}.{domain}", ...}

# ---------- 其它（一般不用改）----------
INSPECTOR_TIMEZONE=Asia/Shanghai
INSPECTOR_DEMO_SEED=false
# 同源访问（经 nginx）不需要 CORS
INSPECTOR_CORS_ORIGINS=[]
# 构建镜像时的软件源（只在有源码的构建机上使用）
# PIP_INDEX_URL=https://mirrors.example.com/pypi/simple
# NPM_REGISTRY=https://mirrors.example.com/npm/
